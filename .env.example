# ---------------------------------------------------------------------------
# Ambiente
# ---------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true

# ---------------------------------------------------------------------------
# Banco de dados (PostgreSQL)
# ---------------------------------------------------------------------------
POSTGRES_USER=fin
POSTGRES_PASSWORD=fin
POSTGRES_DB=fin
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Sobrescreve a URL montada a partir das variaveis acima (opcional)
# DATABASE_URL=postgresql+psycopg2://fin:fin@db:5432/fin

# ---------------------------------------------------------------------------
# Pool de conexoes
#
# DB_POOL_PRE_PING testa a conexao antes de cada uso: custa uma ida ao banco por
# requisicao (186 ms com o banco em Oregon, 11 ms em Sao Paulo) e evita erro
# quando o pooler derruba uma conexao ociosa. Desligue so conscientemente.
# ---------------------------------------------------------------------------
DB_POOL_PRE_PING=true
DB_POOL_RECYCLE=1800
# Em serverless (Vercel) o pool do SQLAlchemy atrapalha em vez de ajudar: liga
# sozinho quando a variavel VERCEL existe. So defina aqui para forcar.
# DB_DISABLE_POOL=false

# ---------------------------------------------------------------------------
# Identidade (Supabase Auth)
#
# O backend NAO emite nem valida senhas: quem cuida disso e o Supabase Auth. A
# API so confere a assinatura, o emissor e a audiencia do JWT que o cliente
# envia. Por isso nao ha SECRET_KEY nem tempo de expiracao aqui -- a sessao e
# governada pelo painel do Supabase.
# ---------------------------------------------------------------------------
SUPABASE_URL=
# Chave publicavel (anon). Feita para ficar exposta no bundle do frontend.
SUPABASE_ANON_KEY=
# Chave service_role: ignora RLS e da acesso total ao banco.
#
# NENHUM codigo do projeto a utiliza hoje. Enquanto estiver preenchida aqui, e
# um segredo com poder total e sem funcao -- deixe VAZIA a menos que va usa-la,
# e nunca a exponha ao frontend.
SUPABASE_SERVICE_KEY=
# Projetos novos assinam com JWKS assimetrico e deixam o segredo abaixo vazio.
# Preencha apenas em projetos legados que ainda usam HS256.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

# ---------------------------------------------------------------------------
# Limite de requisicoes e documentacao
# ---------------------------------------------------------------------------
# Teto por cliente por minuto. O de mercado e menor porque cada chamada dessas
# consome cota da brapi.
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_MARKET_PER_MINUTE=30
# /docs, /redoc e /openapi.json. Sem valor definido, ficam ligados fora de
# producao e desligados em producao -- onde so servem de mapa para quem sondar.
# DOCS_ENABLED=false

# ---------------------------------------------------------------------------
# CORS (origens do frontend, separadas por virgula)
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Regex adicional para origens que nao dao para listar, como os deploy previews
# do Netlify (um subdominio novo por build). Deixe vazio se nao precisar.
# CORS_ORIGIN_REGEX=https://.*--meu-site\.netlify\.app

# ---------------------------------------------------------------------------
# OAuth - Google (opcional; deixe vazio para desabilitar o provider)
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback/google

# ---------------------------------------------------------------------------
# Dados de mercado - brapi.dev (investimentos)
#
# Segredo de servidor: NUNCA prefixe com VITE_ e nunca exponha ao navegador.
# O frontend fala apenas com a nossa API; quem chama a brapi e o backend.
#
# Obtenha um token em https://brapi.dev (o plano gratuito atende cotacao,
# historico, dividendos e busca; criptomoedas exigem plano pago).
# Sem token a brapi ainda responde, porem com limite de requisicoes menor.
# Deixe MARKET_DATA_PROVIDER=none para desligar a busca automatica.
# ---------------------------------------------------------------------------
MARKET_DATA_PROVIDER=brapi
BRAPI_BASE_URL=https://brapi.dev/api
BRAPI_TOKEN=
BRAPI_TIMEOUT_SECONDS=12
BRAPI_MAX_RETRIES=2
BRAPI_BATCH_SIZE=10

# Cache de dados de mercado, em segundos.
QUOTE_CACHE_TTL_SECONDS=300
HISTORY_CACHE_TTL_SECONDS=3600
DIVIDENDS_CACHE_TTL_SECONDS=21600
SEARCH_CACHE_TTL_SECONDS=86400
# Por quanto tempo uma cotacao vencida ainda pode ser exibida quando a brapi
# esta fora do ar, sempre marcada como desatualizada.
QUOTE_STALE_MAX_AGE_SECONDS=86400

# ---------------------------------------------------------------------------
# Taxas de referencia - Banco Central (contas remuneradas)
#
# Fonte do CDI para contas que rendem % do CDI. A API do BCB e publica e nao
# exige token nem cadastro. "none" desliga o rendimento automatico.
# ---------------------------------------------------------------------------
RATE_PROVIDER=bcb
BCB_BASE_URL=https://api.bcb.gov.br
BCB_TIMEOUT_SECONDS=12
# Serie de mes fechado nao muda mais; a do mes corrente ainda recebe pontos.
RATE_CACHE_TTL_SECONDS=21600
RATE_HISTORY_CACHE_TTL_SECONDS=2592000

# ---------------------------------------------------------------------------
# Camada de IA - reservado para o futuro. Nao implementado nesta versao.
# ---------------------------------------------------------------------------
AI_PROVIDER=none
AI_API_KEY=

# ---------------------------------------------------------------------------
# Frontend
#
# Em desenvolvimento estas variaveis sao lidas deste arquivo pelo Vite. Em
# producao elas vivem no painel do Netlify (Site settings > Environment
# variables) e sao embutidas no bundle durante o build -- por isso so podem
# conter valores publicos. Ver docs/deploy.md.
# ---------------------------------------------------------------------------
VITE_API_URL=http://localhost:8000/api/v1
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
